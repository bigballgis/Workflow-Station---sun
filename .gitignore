# =============================================================================
# Platform .gitignore - Ensure only source code is committed
# =============================================================================

# =============================================================================
# Build outputs
# =============================================================================
target/
build/
out/
dist/

# Playwright UI verification screenshots (kept locally; see frontend/*/verification-screenshots/README.md)
frontend/*/verification-screenshots/*.png

*.class
*.jar
*.war
*.ear
*.tar.gz
*.rar

# =============================================================================
# IDE and Editor files
# =============================================================================
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Eclipse
.project
.classpath
.settings/
.metadata/
bin/

# VS Code — ignore workspace junk; keep folderOpen sync task committed
.vscode/*
!.vscode/tasks.json
*.code-workspace

# NetBeans
nbproject/
nbbuild/
nbdist/
nb-configuration.xml

# =============================================================================
# Maven
# =============================================================================
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# =============================================================================
# Gradle
# =============================================================================
.gradle/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# =============================================================================
# Node.js / Frontend
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# Note: pnpm-lock.yaml must be tracked to ensure consistent dependency versions
# across environments. The frontends use pnpm (pinned via each package.json's
# "packageManager"); activepieces/ has always used it.
# pnpm-lock.yaml
# yarn.lock

# Vue / Vite
.nuxt/
.output/
.vite/
*.timestamp-*.mjs

# Auto-generated TypeScript declaration files (unplugin-vue-components / unplugin-auto-import)
# These are regenerated on every build and must not be committed
frontend/*/src/components.d.ts
frontend/*/src/auto-imports.d.ts

# =============================================================================
# Logs
# =============================================================================
logs/
**/logs/
*.log
*.log.*
log/
**/log/

# =============================================================================
# Temporary files
# =============================================================================
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~
.cache/

# =============================================================================
# OS generated files
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# SENSITIVE FILES - NEVER COMMIT
# =============================================================================
# Environment files with secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.env

# Exception: Allow environment template files in deploy/environments/
# These are example configurations for different environments
!deploy/environments/**/.env
!deploy/environments/**/.env.*

# Superset BuildKit pip secret (Nexus credentials) — never commit real pip.conf
deploy/superset/pip.conf

# Dev schema-migration SHA markers (isolated per Postgres Docker volume)
deploy/environments/dev/.schema-migration-markers/

# Secret/credential files
secrets/
credentials/
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore
*.truststore

# AWS credentials
.aws/
aws-credentials*

# SSH keys
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub
*.ppk

# API keys and tokens
api-keys.txt
api-keys.json
tokens.txt
tokens.json
*-secret.yml
*-secret.yaml
*-secrets.yml
*-secrets.yaml

# Database credentials
database.yml
database.properties
db-credentials*

# Application secrets
application-secrets.yml
application-secrets.yaml
application-secrets.properties
bootstrap-secrets.yml
bootstrap-secrets.yaml

# JWT secrets
jwt-secret*
jwt.key

# Encryption keys
encryption-key*
master-key*
aes-key*

# =============================================================================
# Configuration files with potential secrets
# =============================================================================
# Keep templates, ignore actual configs
!*-template.yml
!*-template.yaml
!*-template.properties
!*-example.yml
!*-example.yaml
!*-example.properties

# Local configuration overrides
application-local.yml
application-local.yaml
application-local.properties
*-local.yml
*-local.yaml
*-local.properties

# =============================================================================
# Kubernetes secrets (actual secrets, not templates)
# =============================================================================
*-secret.yaml
*-secret.yml
secrets.yaml
secrets.yml
!*-secret-template.yaml
!*-secret-template.yml

# =============================================================================
# Test outputs
# =============================================================================
test-output/
test-results/
coverage/
*.coverage
.nyc_output/
htmlcov/
.tox/
.pytest_cache/
**/.jqwik-database
.jqwik-database
*/.jqwik-database
*/*/.jqwik-database

# =============================================================================
# Database files
# =============================================================================
*.db
*.sqlite
*.sqlite3
*.h2.db
*.mv.db
*.trace.db

# =============================================================================
# Backup files
# =============================================================================
*.bak
*.backup
*.old
*.orig

# =============================================================================
# Generated documentation
# =============================================================================
site/
javadoc/
apidocs/

# =============================================================================
# Heap dumps and profiling
# =============================================================================
*.hprof
*.heap
hs_err_pid*
replay_pid*

# =============================================================================
# Spring Boot
# =============================================================================
HELP.md
.spring-boot-devtools.properties

# =============================================================================
# EXTERNAL: AI LOG MARKDOWN FILES
# =============================================================================
docs/troubleshooting/session-logs/

# =============================================================================
# Project-specific exclusions
# =============================================================================
# 产品文档位于 docs/（已纳入版本库）；勿将临时 AI 输出写入该目录。

# Extracted JAR build artifacts
BOOT-INF/

# Root-level temp/debug files
/_tmp_*
/_tmp_*.js
/*.sql
/*.json
!package.json
!tsconfig.json
# ── AI guidance：唯一真源是 .cursor/rules + .cursor/skills ──────────────────
# .claude / .kiro / .github 下的规则与技能都是 sync-cursor-rules.mjs 生成的镜像，
# 一律不入库；改规则只改 .cursor/**，各工具本地跑同步脚本自行生成。
# 例外：生成器本体（sync-cursor-rules.mjs）与触发它的 SessionStart hook 配置
# （settings.json）不是镜像而是真源的一部分，显式放行；个人配置仍走 settings.local.json。
# .kiro：只排生成物（steering/ + skills/）；specs/ 与 issues* 是手写内容，保留入库。
# issue-tracking.md 是手写 steering（同步脚本的 keep hand-written 名单里），
# 生成不出来，必须入库，否则新克隆会丢。
.kiro/*
!.kiro/specs/
!.kiro/specs/**
!.kiro/issues.md
!.kiro/issues/
!.kiro/issues/**
!.kiro/steering/
.kiro/steering/*
!.kiro/steering/issue-tracking.md
# .github：只排生成物（copilot-instructions.md / instructions/ / skills/）。
# workflows/ 是 CI，hooks/sync-ai-guidance.json 是 Copilot 的同步触发器（真源，
# 且被 ai-guidance-sync.yml 断言存在），PR 模板同理，都保留入库。
.github/*
!.github/workflows/
!.github/workflows/**
!.github/hooks/
!.github/hooks/**
!.github/pull_request_template.md
# build.yml 的 surefire excludesFile：CI 的隔离清单，必须入库否则 CI 跑不起来。
!.github/known-test-failures.txt
.claude/*
!.claude/scripts/
!.claude/scripts/**
!.claude/settings.json
.claude/settings.local.json
!documentation/*.md
# Windows 上 core.ignorecase 会导致 *.MD 误匹配小写 .md；显式放行版本库文档目录
!docs/**/*.md
# Local ad-hoc Playwright dumps / underscore-prefixed scratch verify scripts (not product)
frontend/scripts/_*.json
frontend/scripts/_*.mjs

deploy/pieces_metadata*

# 前端/AP 构建产物压缩包不入库。web-embed 曾以 deploy/pieces/web-embed-<sha>.zip 提交过一次
# （9.15 MiB，git 里删不掉），它绕开了 activepieces/.gitignore 的 `dist` 规则。产物走带外分发 +
# build-and-push-k8s.ps1 的 -SkipApWorkspaceInstall 复用路径，见 BUILD_GUIDE 7.2。
# 注意:activepieces/hermes/tarballs/*.tgz 是**有意**入库的（13 个件共 344 KB，气隙投放物料），
# 与此不同——那是无法重建的审批产物,这里是每次都能从源码重建的构建产物。
deploy/**/*.zip
