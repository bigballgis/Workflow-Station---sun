# =============================================================================
# Platform .gitignore - Ensure only source code is committed
# =============================================================================

# =============================================================================
# Build outputs
# =============================================================================
target/
build/
out/
dist/

# Playwright UI verification screenshots (kept locally; see frontend/*/verification-screenshots/README.md)
frontend/*/verification-screenshots/*.png

*.class
*.jar
*.war
*.ear
*.tar.gz
*.rar

# =============================================================================
# IDE and Editor files
# =============================================================================
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Eclipse
.project
.classpath
.settings/
.metadata/
bin/

# VS Code — ignore workspace junk; keep folderOpen sync task committed
.vscode/*
!.vscode/tasks.json
*.code-workspace

# NetBeans
nbproject/
nbbuild/
nbdist/
nb-configuration.xml

# =============================================================================
# Maven
# =============================================================================
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# =============================================================================
# Gradle
# =============================================================================
.gradle/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# =============================================================================
# Node.js / Frontend
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# Note: package-lock.json, yarn.lock, pnpm-lock.yaml should be tracked
# to ensure consistent dependency versions across environments
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Vue / Vite
.nuxt/
.output/
.vite/
*.timestamp-*.mjs

# Auto-generated TypeScript declaration files (unplugin-vue-components / unplugin-auto-import)
# These are regenerated on every build and must not be committed
frontend/*/src/components.d.ts
frontend/*/src/auto-imports.d.ts

# =============================================================================
# Logs
# =============================================================================
logs/
**/logs/
*.log
*.log.*
log/
**/log/

# =============================================================================
# Temporary files
# =============================================================================
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~
.cache/

# =============================================================================
# OS generated files
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# SENSITIVE FILES - NEVER COMMIT
# =============================================================================
# Environment files with secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.env

# Exception: Allow environment template files in deploy/environments/
# These are example configurations for different environments
!deploy/environments/**/.env
!deploy/environments/**/.env.*

# Superset BuildKit pip secret (Nexus credentials) — never commit real pip.conf
deploy/superset/pip.conf

# Dev schema-migration SHA markers (isolated per Postgres Docker volume)
deploy/environments/dev/.schema-migration-markers/

# Secret/credential files
secrets/
credentials/
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore
*.truststore

# AWS credentials
.aws/
aws-credentials*

# SSH keys
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub
*.ppk

# API keys and tokens
api-keys.txt
api-keys.json
tokens.txt
tokens.json
*-secret.yml
*-secret.yaml
*-secrets.yml
*-secrets.yaml

# Database credentials
database.yml
database.properties
db-credentials*

# Application secrets
application-secrets.yml
application-secrets.yaml
application-secrets.properties
bootstrap-secrets.yml
bootstrap-secrets.yaml

# JWT secrets
jwt-secret*
jwt.key

# Encryption keys
encryption-key*
master-key*
aes-key*

# =============================================================================
# Configuration files with potential secrets
# =============================================================================
# Keep templates, ignore actual configs
!*-template.yml
!*-template.yaml
!*-template.properties
!*-example.yml
!*-example.yaml
!*-example.properties

# Local configuration overrides
application-local.yml
application-local.yaml
application-local.properties
*-local.yml
*-local.yaml
*-local.properties

# =============================================================================
# Kubernetes secrets (actual secrets, not templates)
# =============================================================================
*-secret.yaml
*-secret.yml
secrets.yaml
secrets.yml
!*-secret-template.yaml
!*-secret-template.yml

# =============================================================================
# Test outputs
# =============================================================================
test-output/
test-results/
coverage/
*.coverage
.nyc_output/
htmlcov/
.tox/
.pytest_cache/
**/.jqwik-database
.jqwik-database
*/.jqwik-database
*/*/.jqwik-database

# =============================================================================
# Database files
# =============================================================================
*.db
*.sqlite
*.sqlite3
*.h2.db
*.mv.db
*.trace.db

# =============================================================================
# Backup files
# =============================================================================
*.bak
*.backup
*.old
*.orig

# =============================================================================
# Generated documentation
# =============================================================================
site/
javadoc/
apidocs/

# =============================================================================
# Heap dumps and profiling
# =============================================================================
*.hprof
*.heap
hs_err_pid*
replay_pid*

# =============================================================================
# Spring Boot
# =============================================================================
HELP.md
.spring-boot-devtools.properties

# =============================================================================
# EXTERNAL: AI LOG MARKDOWN FILES
# =============================================================================
docs/troubleshooting/session-logs/

# =============================================================================
# Project-specific exclusions
# =============================================================================
# 产品文档位于 docs/（已纳入版本库）；勿将临时 AI 输出写入该目录。

# Extracted JAR build artifacts
BOOT-INF/

# Root-level temp/debug files
/_tmp_*
/_tmp_*.js
/*.sql
/*.json
!package.json
!package-lock.json
!tsconfig.json
frontend/admin-center/package-lock.json
frontend/developer-workstation/package-lock.json
frontend/user-portal/package-lock.json
# Kiro local artifacts — ignore by default; commit generated AI guidance mirrors
.kiro/*
!.kiro/steering/
!.kiro/steering/**
!.kiro/skills/
!.kiro/skills/**
!documentation/*.md
# Windows 上 core.ignorecase 会导致 *.MD 误匹配小写 .md；显式放行版本库文档目录
!docs/**/*.md
# Claude Code personal settings
.claude/settings.local.json
# .claude/skills 由 sync-cursor-rules.mjs 从 .cursor/skills 镜像；入库以便 CI 防漂移
# Local ad-hoc Playwright dumps / underscore-prefixed scratch verify scripts (not product)
frontend/scripts/_*.json
frontend/scripts/_*.mjs

deploy/pieces_metadata*
