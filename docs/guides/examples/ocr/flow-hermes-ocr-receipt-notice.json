          "sourceCode" : {
            "code" : "export const code = async (inputs) => {\n  // The Content Organizer step runs with \"continue on failure\": on success its output holds\n  // {values}; on failure the output is empty and the error message explains why.\n  const values = inputs.result && inputs.result.values;\n  if (values) {\n    return { ...values, ocr_status: 'SUCCESS', ocr_message: 'Extracted by Content Organizer; please review' };\n  }\n  // AP wraps a piece error as a JSON string ({\"message\": ...}); show the plain message.\n  let reason = (inputs.error && inputs.error.message) || 'no result';\n  try { reason = JSON.parse(reason).message || reason; } catch (e) { /* already plain text */ }\n  return { ocr_status: 'FAILED', ocr_message: ('OCR failed: ' + reason).slice(0, 500) };\n};",
