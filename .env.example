# =====================================================
# Low-Code Workflow Platform - Environment Configuration
# Copy this file to .env and update values for your environment
# =====================================================

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workflow_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT Configuration
# Generate a secure 256-bit key for production
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Encryption Configuration
# Must be exactly 32 bytes for AES-256
ENCRYPTION_SECRET_KEY=your-32-byte-aes-256-secret-key!!

# Application Configuration
SPRING_PROFILES_ACTIVE=dev

# Logging
LOG_LEVEL=INFO

# Server Configuration
WORKFLOW_ENGINE_PORT=8081
ADMIN_CENTER_PORT=8082
DEVELOPER_WORKSTATION_PORT=8083
USER_PORTAL_PORT=8084

# Kong Gateway
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# SSO（统一登录 /login；admin-center / user-portal / developer-workstation 须使用相同值）
SSO_INTERNAL_TOKEN=generate-a-long-random-secret-for-sso-redeem
# 可选：OAuth 回跳前缀（须含子路径，与各前端 Vite base 一致，例如 /admin/sso/callback）
# 本地 Docker dev 推荐使用边缘入口单端口，见 deploy/environments/dev/.env 中 EDGE_FRONTEND_PORT
# SSO_REDIRECT_ADMIN_PREFIX=http://localhost:3070/admin/sso/callback
# SSO_REDIRECT_PORTAL_PREFIX=http://localhost:3070/portal/sso/callback
# SSO_REDIRECT_DW_PREFIX=http://localhost:3070/dev/sso/callback
