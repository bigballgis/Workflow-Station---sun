# HERMES-PATCH(deploy): dropped upstream's two npmjs.org lines.
#
#   @activepieces:registry=https://registry.npmjs.org/
#   //registry.npmjs.org/:_authToken=${NPM_TOKEN}
#
# The auth token only ever served upstream's release-pieces.yml, which publishes
# @activepieces/* to npm — a workflow that cannot even run here (GitHub reads only the
# repo root's .github/workflows) and a thing we never do. Its cost was real: with
# NPM_TOKEN unset, pnpm 9 emits one WARN and then discards this ENTIRE file, so every
# setting below was silently inert — including in the AP image build, which COPYs this
# file and installs without a token.
#
# The scope pin had to go with it. Keeping the pin while fixing the parse would have made
# it effective for the first time and sent the four registry-fetched @activepieces
# packages (import-fresh-webpack, plus transitive pieces-framework and shared) straight to
# the public registry, bypassing a private mirror — exactly wrong on an air-gapped or
# Nexus-only build host. Without it everything resolves through the default registry,
# whatever the host is configured for; pnpm-lock.yaml's integrity hashes still pin the
# content, so the mirror cannot substitute anything.
save-exact=true
auto-install-peers=true
strict-peer-dependencies=false
