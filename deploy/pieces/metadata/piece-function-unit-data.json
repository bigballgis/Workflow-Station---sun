          "required": true,
          "type": "ARRAY"
        },
        "size": {
          "displayName": "Page Size",
          "required": false,
          "defaultValue": 50,
          "type": "NUMBER"
        }
      },
      "requireAuth": true,
      "errorHandlingOptions": {
        "continueOnFailure": {
          "defaultValue": false
        },
        "retryOnFailure": {
          "defaultValue": false
        }
