      "props": {
        "notice": {
          "displayName": "Markdown",
          "required": false,
          "description": "以工作区运行身份执行。本步骤不能选择同事，也不能填写操作人。",
          "type": "MARKDOWN",
          "variant": "INFO"
        },
        "functionUnitCode": {
          "displayName": "Function Unit Code",
          "required": true,
          "type": "SHORT_TEXT"
        },
        "filters": {
          "displayName": "Filters",
