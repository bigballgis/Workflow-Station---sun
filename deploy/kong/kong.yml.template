_format_version: "3.0"
_transform: true

# ============================================================
# Services (上游后端服务)
# ============================================================
services:
  # --- admin-center ---
  - name: admin-center-service
    url: http://admin-center:8080
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: admin-center-route
        paths:
          - /api/v1/admin
        strip_path: false
        preserve_host: false

  # --- developer-workstation ---
  # 同一路径前缀的多条路由：具体路径必须列在 /api/v1 通配之前，保证 /api/v1/auth/* 等到正确上游
  - name: developer-workstation-service
    url: http://developer-workstation:8080
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: dw-auth-login-route
        paths:
          - /api/v1/auth/login
        strip_path: false
        preserve_host: false
      - name: dw-auth-refresh-route
        paths:
          - /api/v1/auth/refresh
        strip_path: false
        preserve_host: false
      - name: upload-route
        paths:
          - /api/v1/upload
          - /api/v1/import
        strip_path: false
        preserve_host: false
      - name: developer-workstation-route
        paths:
          - /api/v1
        strip_path: false
        preserve_host: false

  # --- developer-workstation SSE (AI 生成) ---
  - name: developer-workstation-sse-service
    url: http://developer-workstation:8080
    connect_timeout: 60000
    write_timeout: 300000
    read_timeout: 300000
    routes:
      - name: developer-workstation-sse-route
        paths:
          - /api/v1/ai-generation
        strip_path: false
        preserve_host: false

  # --- user-portal ---
  - name: user-portal-service
    url: http://user-portal:8080
    connect_timeout: 60000
    write_timeout: 600000
    read_timeout: 600000
    routes:
      - name: user-portal-route
        paths:
          - /api/portal
        strip_path: false
        preserve_host: false

  # --- user-portal WebSocket ---
  - name: user-portal-ws-service
    url: http://user-portal:8080
    connect_timeout: 60000
    write_timeout: 86400000
    read_timeout: 86400000
    routes:
      - name: user-portal-ws-route
        paths:
          - /api/portal/ws
        strip_path: false
        preserve_host: false
        protocols:
          - http
          - https

  # --- workflow-engine-core ---
  - name: workflow-engine-service
    url: http://workflow-engine:8080
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: workflow-engine-route
        paths:
          - /api/workflow
        strip_path: false
        preserve_host: false

  # --- 公开路由 (不启用 JWT 插件) ---
  # admin-center 登录
  - name: admin-center-auth-service
    url: http://admin-center:8080
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: admin-auth-login-route
        paths:
          - /api/v1/admin/auth/login
        strip_path: false
        preserve_host: false
      - name: admin-auth-refresh-route
        paths:
          - /api/v1/admin/auth/refresh
        strip_path: false
        preserve_host: false
      - name: admin-sso-login-route
        paths:
          - /api/v1/admin/sso/login
        strip_path: false
        preserve_host: false
      - name: admin-auth-sso-exchange-route
        paths:
          - /api/v1/admin/auth/sso/exchange
        strip_path: false
        preserve_host: false

  # user-portal 登录
  - name: user-portal-auth-service
    url: http://user-portal:8080
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: portal-auth-login-route
        paths:
          - /api/portal/auth/login
        strip_path: false
        preserve_host: false
      - name: portal-auth-refresh-route
        paths:
          - /api/portal/auth/refresh
        strip_path: false
        preserve_host: false

  # n8n 回调
  - name: workflow-engine-callback-service
    url: http://workflow-engine:8080
    connect_timeout: 60000
    write_timeout: 60000
    read_timeout: 60000
    routes:
      - name: n8n-callback-route
        paths:
          - /api/workflow/n8n/callback
        strip_path: false
        preserve_host: false

# ============================================================
# Plugins (全局插件)
# ============================================================
plugins:
  # --- correlation-id: 分布式追踪 ---
  - name: correlation-id
    config:
      header_name: X-Trace-Id
      generator: uuid#counter
      echo_downstream: true

  # --- CORS ---
  - name: cors
    config:
      origins:
        - __CORS_ALLOWED_ORIGINS__
      methods:
        - GET
        - POST
        - PUT
        - DELETE
        - PATCH
        - OPTIONS
      headers:
        - Authorization
        - Content-Type
        - X-Trace-Id
        - Accept
        - Origin
        - X-Requested-With
      exposed_headers:
        - X-RateLimit-Limit
        - X-RateLimit-Remaining
        - X-RateLimit-Reset
        - X-Trace-Id
      max_age: 3600
      credentials: true

  # --- 全局限流 (默认 600/分钟) ---
  - name: rate-limiting
    config:
      minute: 600
      policy: redis
      redis:
        host: __REDIS_HOST__
        port: 6379
        password: __REDIS_PASSWORD__
        database: 5
      limit_by: ip
      hide_client_headers: false
      fault_tolerant: true

  # --- JWT 认证已由后端 JwtAuthenticationFilter 处理 ---
  # Kong 不做 JWT 验证，仅做路由转发、CORS、限流和追踪

  # --- Prometheus 监控 ---
  - name: prometheus
    config:
      per_consumer: false
      status_code_metrics: true
      latency_metrics: true
      bandwidth_metrics: true
      upstream_health_metrics: true

  # --- 登录端点路由级限流 (10/分钟) ---
  - name: rate-limiting
    route: admin-auth-login-route
    config:
      minute: 10
      policy: redis
      redis:
        host: __REDIS_HOST__
        port: 6379
        password: __REDIS_PASSWORD__
        database: 5
      limit_by: ip

  - name: rate-limiting
    route: portal-auth-login-route
    config:
      minute: 10
      policy: redis
      redis:
        host: __REDIS_HOST__
        port: 6379
        password: __REDIS_PASSWORD__
        database: 5
      limit_by: ip

  - name: rate-limiting
    route: dw-auth-login-route
    config:
      minute: 10
      policy: redis
      redis:
        host: __REDIS_HOST__
        port: 6379
        password: __REDIS_PASSWORD__
        database: 5
      limit_by: ip

  - name: rate-limiting
    route: admin-sso-login-route
    config:
      minute: 10
      policy: redis
      redis:
        host: __REDIS_HOST__
        port: 6379
        password: __REDIS_PASSWORD__
        database: 5
      limit_by: ip

  # --- Token 刷新端点路由级限流 (20/分钟) ---
  - name: rate-limiting
    route: admin-auth-refresh-route
    config:
      minute: 20
      policy: redis
      redis:
        host: __REDIS_HOST__
        port: 6379
        password: __REDIS_PASSWORD__
        database: 5
      limit_by: ip

  - name: rate-limiting
    route: portal-auth-refresh-route
    config:
      minute: 20
      policy: redis
      redis:
        host: __REDIS_HOST__
        port: 6379
        password: __REDIS_PASSWORD__
        database: 5
      limit_by: ip

  - name: rate-limiting
    route: dw-auth-refresh-route
    config:
      minute: 20
      policy: redis
      redis:
        host: __REDIS_HOST__
        port: 6379
        password: __REDIS_PASSWORD__
        database: 5
      limit_by: ip

# ============================================================
# Upstreams — removed (not referenced by services)
# ============================================================
# Services use direct URLs (e.g. http://admin-center:8080).
# To enable health checks, change service URLs to upstream names
# and uncomment the upstream definitions.
# See: https://docs.konghq.com/gateway/latest/how-kong-works/load-balancing/
