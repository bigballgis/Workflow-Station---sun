# =====================================================
# UAT Environment - Reference Configuration
# =====================================================
# Deployed on company K8S. See deploy/k8s/ for manifests.
#
# PostgreSQL: 使用公司现有数据库（不部署）
# Redis / Kafka / N8N: K8S 自行部署
#
# This file is a reference for K8S ConfigMap/Secret values.
# =====================================================

# --- Environment ---
ENVIRONMENT=uat
SPRING_PROFILES_ACTIVE=uat

# --- Registry ---
REGISTRY=harbor.company.com/workflow
IMAGE_TAG=latest

# --- Database (公司现有 PostgreSQL，不部署) ---
POSTGRES_HOST=uat-postgres.internal
POSTGRES_PORT=5432
POSTGRES_DB=workflow_platform_uat
POSTGRES_USER=platform_uat
POSTGRES_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:postgresql://uat-postgres.internal:5432/workflow_platform_uat

# --- Redis (K8S 自行部署) ---
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# --- Kafka (K8S 自行部署, KRaft 模式) ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka-service:29092

# --- JWT ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=43200000
JWT_REFRESH_EXPIRATION=259200000

# --- Encryption ---
ENCRYPTION_SECRET_KEY=CHANGE_ME

# --- Service URLs (K8S internal service names) ---
ADMIN_CENTER_URL=http://admin-center-service:8080
WORKFLOW_ENGINE_URL=http://workflow-engine-service:8080
DEVELOPER_WORKSTATION_URL=http://developer-workstation-service:8080
USER_PORTAL_URL=http://user-portal-service:8080

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://hermes-uat.hk.hsbc,http://hermes-uat.hk.hsbc,https://uat-admin.company.com,https://uat-portal.company.com,https://uat-dev.company.com

# --- Logging ---
LOG_LEVEL=INFO
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_PLATFORM=INFO
LOG_LEVEL_SQL=WARN

# --- Cache TTL (minutes) ---
CACHE_USER_TTL_MINUTES=45
CACHE_PERMISSION_TTL_MINUTES=90
CACHE_DICTIONARY_TTL_MINUTES=180

# --- Security ---
SECURITY_PASSWORD_MIN_LENGTH=10
SECURITY_LOGIN_MAX_FAILED_ATTEMPTS=3
SECURITY_SESSION_TIMEOUT_MINUTES=30

# --- Features ---
SWAGGER_ENABLED=false
FLOWABLE_SCHEMA_UPDATE=false

# --- Connection Pool ---
HIKARI_MAXIMUM_POOL_SIZE=20
HIKARI_MINIMUM_IDLE=5
HIKARI_CONNECTION_TIMEOUT=20000

# --- K8S Server Port ---
SERVER_PORT=8080

# --- N8N (K8S 自行部署) ---
N8N_DB_NAME=n8n_uat
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_WEBHOOK_URL=https://uat-n8n.company.com

# --- Doubao LLM API (N8N 发票识别) ---
DOUBAO_MODEL_ID=CHANGE_ME
DOUBAO_API_KEY=CHANGE_ME

# =====================================================================
# LDAP / SSO-DSP (admin-center, UAT 真实值)
# =====================================================================
# 重要 1：以下 env 名是「本仓库 admin-center 实际读取」的名字（见 backend/admin-center
#         /src/main/resources/application.yml），与你提供的源项目映射表有差异。请勿用源项目名，
#         否则 admin-center 读不到（差异见对话/下方注释）。
# 重要 2：真实密钥不写本文件（本文件被 git 跟踪）。密钥占位为 CHANGE_ME_UAT_*，真实值放：
#         同目录 secrets.env（已被 .gitignore 忽略）或部署时注入 K8s Secret deploy/k8s/secret/uat。

# --- 开关 ---
LDAP_ENABLED=true
DSP_SSO_ENABLED=true
# UAT 为真实环境：严禁开发跳过角色校验（必须 false）
ADMIN_DEV_BYPASS_ROLE_CHECK=false

# --- LDAP / AD 连接 (UAT) ---
LDAP_PROVIDER_URL=ldaps://aa-lds-prod.hk.hsbc:3269
LDAP_BASE_DN=OU=HSBCPeople,DC=InfoDir,DC=Prod,DC=HSBC
LDAP_BIND_DN=CN=HK-SVCA-HERMES,OU=Service Accounts,DC=InfoDir,DC=Prod,DC=HSBC
# 密钥占位 → secrets.env / K8s Secret（键 LDAP_BIND_PASSWORD）
LDAP_BIND_PASSWORD=CHANGE_ME_UAT_LDAP_BIND_PASSWORD
LDAP_TLS=true
# 命名差异：本实现以 _MS 结尾（源项目映射表写作 LDAP_CONNECT_TIMEOUT / LDAP_READ_TIMEOUT）
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_READ_TIMEOUT_MS=10000
LDAP_PAGE_SIZE=500
LDAP_MAX_ENTRIES=0
LDAP_USER_SEARCH_FILTER=(|(objectclass=userproxy)(objectclass=user))
LDAP_SYNC_ENABLED=true
LDAP_SYNC_CRON=0 0 */2 * * ?
# LDAPS truststore（含 DSP CA 链）：路径非密；口令为密钥占位 → secrets.env / K8s Secret
LDAP_KEYSTORE_PATH=/tmp/dsp-cacerts
LDAP_KEYSTORE_PASSWORD=CHANGE_ME_UAT_LDAP_KEYSTORE_PASSWORD
# 属性名默认即 HSBC AD（employeeID/uid/cn/displayName/givenName/sn/mail/telephoneNumber/
# hsbc-ad-SAMAccountName 等），无需覆盖。源项目的 LDAP_RETRIEVE_ATTRS 在本实现拆为逐属性
# LDAP_ATTR_*，仅当改用其它目录 schema 时才需设置。

# --- Hermes AD 组 → 角色同步 ---
# 环境名（UAT）：用于构建 AD 组名
LDAP_HERMES_ENV=UAT
LDAP_GROUP_SEARCH_BASE_DN=DC=InfoDir,DC=Prod,DC=HSBC
# 显式映射（优先于 roles+pattern）：每个环境的组名由 Infodir-Hermes-Default-{env}-{role} 构成
LDAP_HERMES_GROUP_SYNC_GROUPS=Admin=Infodir-Hermes-Default-UAT-Admin,User=Infodir-Hermes-Default-UAT-User,Developer=Infodir-Hermes-Default-UAT-Developer
# roles + pattern 兜底（未配显式映射时使用）：
LDAP_HERMES_GROUP_SYNC_ROLES=Admin,User,Developer
LDAP_HERMES_GROUP_SYNC_PATTERN=Infodir-Hermes-Default-{env}-{role}
LDAP_HERMES_GROUP_SYNC_BATCH_SIZE=20

# --- DSP 免密 (admin-center runtime) ---
DSP_AUTHENTICATE_URL=https://cmb-staff-dsp-uat.hk.hsbc:8443/dsp/dspAuthenticate.jsp?realm=staff&service=wdssoservice
DSP_TRANSLATOR_URL=https://cmb-staff-dsp-uat.hk.hsbc:8443/dsp/rest-sts/staff/tokenTranslator?_action=translate
DSP_MANIFEST_LOCATIONS=https://public-key-manifest-v1-cert.apps.cf.skm-drn-01.cloud.hk.hsbc/manifest.json
DSP_CLIENT_ID=HERMES
# 密钥占位 → secrets.env / K8s Secret（键 DSP_CLIENT_SECRET）
DSP_CLIENT_SECRET=CHANGE_ME_UAT_DSP_CLIENT_SECRET
DSP_ACCEPT_API_VERSION=protocol=1.0,resource=1.0
DSP_AM_TOKEN_NAME=AMToken
DSP_E2E_HEADER_NAME=X-HSBC-E2E-Trust-Token
DSP_INPUT_TOKEN_TYPE=SSOTOKEN
DSP_OUTPUT_TOKEN_TYPE=JWT
DSP_ACCEPT_GATEWAY_E2E_TOKEN=false
# 命名差异：源项目 DSP_*_CLAIM_NAMES → 本实现 DSP_*_CLAIMS
DSP_EMPLOYEE_ID_CLAIMS=employeeID,employeeId,emplid,staffId,user.employeeId,sub
DSP_USERNAME_CLAIMS=uid,username,preferred_username,cn,sAMAccountName,hsbc-ad-SAMAccountName,sub

# --- 登录前端 (platform-login build-time) ---
# 登录前端构建期注入。VITE_DSP_ENABLED 控制免密按钮显隐；其余用于「浏览器侧主动获取 AMToken」
# （已实现：useDspLogin → api/dsp.ts POST dspAuthenticate.jsp，带 X-Client-Id/Secret + credentials）。
# 注意：VITE_* 会打进前端产物；VITE_DSP_CLIENT_SECRET 浏览器侧可见（public client），真实值放 secrets.env。
VITE_DSP_ENABLED=true
VITE_DSP_AUTHENTICATE_URL=https://cmb-staff-dsp-uat.hk.hsbc:8443/dsp/dspAuthenticate.jsp?realm=staff&service=wdssoservice
VITE_DSP_CLIENT_ID=HERMES
VITE_DSP_ACCEPT_API_VERSION=protocol=1.0,resource=2.1
# 密钥占位 → secrets.env（键 VITE_DSP_CLIENT_SECRET）；仅当 DSP 要求浏览器侧带 client secret 时启用
VITE_DSP_CLIENT_SECRET=CHANGE_ME_UAT_VITE_DSP_CLIENT_SECRET

# --- SSO 内部 redeem 令牌（密钥）---
# 真实值 → secrets.env / K8s Secret（键 SSO_INTERNAL_TOKEN）；须与各子系统一致，UAT 用强随机值
SSO_INTERNAL_TOKEN=CHANGE_ME_UAT_SSO_INTERNAL_TOKEN
