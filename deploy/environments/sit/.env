# =====================================================
# SIT Environment - Reference Configuration
# =====================================================
# Deployed on company K8S. See deploy/k8s/ for manifests.
#
# PostgreSQL: 使用公司现有数据库（不部署）
# Redis / Kafka / N8N: K8S 自行部署
#
# This file is a reference for K8S ConfigMap/Secret values.
# =====================================================

# --- Environment ---
ENVIRONMENT=sit
SPRING_PROFILES_ACTIVE=sit

# --- Registry ---
REGISTRY=harbor.company.com/workflow
IMAGE_TAG=latest

# --- Database (公司现有 PostgreSQL，不部署) ---
POSTGRES_HOST=sit-postgres.internal
POSTGRES_PORT=5432
POSTGRES_DB=workflow_platform_sit
POSTGRES_USER=platform_sit
POSTGRES_PASSWORD=CHANGE_ME
SPRING_DATASOURCE_URL=jdbc:postgresql://sit-postgres.internal:5432/workflow_platform_sit

# --- Redis (K8S 自行部署) ---
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# --- Kafka (K8S 自行部署, KRaft 模式) ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka-service:29092

# --- JWT ---
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- Encryption ---
ENCRYPTION_SECRET_KEY=CHANGE_ME

# --- Service URLs (K8S internal service names) ---
ADMIN_CENTER_URL=http://admin-center-service:8080
WORKFLOW_ENGINE_URL=http://workflow-engine-service:8080
DEVELOPER_WORKSTATION_URL=http://developer-workstation-service:8080
USER_PORTAL_URL=http://user-portal-service:8080

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://sit-admin.company.com,https://sit-portal.company.com,https://sit-dev.company.com

# --- Logging ---
LOG_LEVEL=INFO
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_PLATFORM=INFO
LOG_LEVEL_SQL=WARN

# --- Cache TTL (minutes) ---
CACHE_USER_TTL_MINUTES=30
CACHE_PERMISSION_TTL_MINUTES=60
CACHE_DICTIONARY_TTL_MINUTES=120

# --- Security ---
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_LOGIN_MAX_FAILED_ATTEMPTS=5
SECURITY_SESSION_TIMEOUT_MINUTES=30

# --- Features ---
SWAGGER_ENABLED=true
FLOWABLE_SCHEMA_UPDATE=true

# --- Connection Pool ---
HIKARI_MAXIMUM_POOL_SIZE=15
HIKARI_MINIMUM_IDLE=3
HIKARI_CONNECTION_TIMEOUT=15000

# --- K8S Server Port ---
SERVER_PORT=8080

# --- N8N (K8S 自行部署) ---
N8N_DB_NAME=n8n_sit
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_WEBHOOK_URL=https://sit-n8n.company.com

# --- Doubao LLM API (N8N 发票识别) ---
DOUBAO_MODEL_ID=CHANGE_ME
DOUBAO_API_KEY=CHANGE_ME
# =====================================================================
# LDAP / SSO-DSP (admin-center, SIT reference)
# =====================================================================
# 重要：真实密钥不要写入本文件（本文件被 git 跟踪）。
# 建议将密钥放在同目录 secrets.env（git 默认忽略 *.env）或部署平台 Secret。
# --- 开关 ---
LDAP_ENABLED=true
DSP_SSO_ENABLED=true
ADMIN_DEV_BYPASS_ROLE_CHECK=false
# --- LDAP / AD 连接 (SIT) ---
LDAP_PROVIDER_URL=ldaps://aa-lds-prod.hk.hsbc:3269
LDAP_BASE_DN=OU=HSBCPeople,DC=InfoDir,DC=Prod,DC=HSBC
LDAP_BIND_DN=CN=HK-SVCA-HERMES,OU=Service Accounts,DC=InfoDir,DC=Prod,DC=HSBC
LDAP_BIND_PASSWORD=CHANGE_ME_SIT_LDAP_BIND_PASSWORD
LDAP_TLS=true
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_READ_TIMEOUT_MS=10000
LDAP_PAGE_SIZE=500
LDAP_MAX_ENTRIES=0
LDAP_USER_SEARCH_FILTER=(&(|(objectclass=userproxy)(objectclass=user))(employeeID={0}))
LDAP_SYNC_ENABLED=true
LDAP_SYNC_CRON=0 0 */2 * * ?
LDAP_KEYSTORE_PATH=/tmp/dsp-cacerts
LDAP_KEYSTORE_PASSWORD=CHANGE_ME_SIT_LDAP_KEYSTORE_PASSWORD
# 显式声明岗位/地址映射，避免历史配置误把地址当岗位
LDAP_ATTR_TITLE=title
LDAP_ATTR_WORK_ROLE=hsbc-ad-WorkRole
LDAP_ATTR_POSTAL_ADDRESS=postalAddress
# --- Hermes AD 组 → 角色同步 ---
LDAP_HERMES_ENV=PPD
LDAP_GROUP_SEARCH_BASE_DN=DC=InfoDir,DC=Prod,DC=HSBC
LDAP_HERMES_GROUP_SYNC_GROUPS=Admin=Infodir-Hermes-Default-PPD-Admin,User=Infodir-Hermes-Default-PPD-User,Developer=Infodir-Hermes-Default-PPD-Developer
LDAP_HERMES_GROUP_SYNC_ROLES=Admin,User,Developer
LDAP_HERMES_GROUP_SYNC_PATTERN=Infodir-Hermes-Default-{env}-{role}
LDAP_HERMES_GROUP_SYNC_BATCH_SIZE=20
# --- DSP 免密 (admin-center runtime) ---
DSP_AUTHENTICATE_URL=CHANGE_ME_SIT_DSP_AUTHENTICATE_URL
DSP_TRANSLATOR_URL=https://cmb-ib2b-dsp-pprod-ap.hk.hsbc:8443/dsp/rest-sts/DSP_iB2B/iB2B_tokenTranslator_v2?_action=translate
DSP_MANIFEST_LOCATIONS=CHANGE_ME_SIT_DSP_MANIFEST_LOCATIONS
DSP_CLIENT_ID=HERMES
DSP_CLIENT_SECRET=CHANGE_ME_SIT_DSP_CLIENT_SECRET
DSP_ACCEPT_API_VERSION=protocol=1.0,resource=1.0
DSP_AM_TOKEN_NAME=AMToken
DSP_E2E_HEADER_NAME=X-HSBC-E2E-Trust-Token
DSP_INPUT_TOKEN_TYPE=SSOTOKEN
DSP_OUTPUT_TOKEN_TYPE=JWT
DSP_ACCEPT_GATEWAY_E2E_TOKEN=false
DSP_EMPLOYEE_ID_CLAIMS=employeeID,employeeId,emplid,staffId,user.employeeId,sub
DSP_USERNAME_CLAIMS=uid,username,preferred_username,cn,sAMAccountName,hsbc-ad-SAMAccountName,sub
# --- 登录前端 (platform-login build-time) ---
VITE_DSP_ENABLED=true
VITE_DSP_AUTHENTICATE_URL=CHANGE_ME_SIT_VITE_DSP_AUTHENTICATE_URL
VITE_DSP_CLIENT_ID=HERMES
VITE_DSP_ACCEPT_API_VERSION=protocol=1.0,resource=2.1
VITE_DSP_CLIENT_SECRET=CHANGE_ME_SIT_VITE_DSP_CLIENT_SECRET
# --- SSO 内部 redeem 令牌（密钥）---
SSO_INTERNAL_TOKEN=CHANGE_ME_SIT_SSO_INTERNAL_TOKEN