    "axios": "^1.6.2",
    "dayjs": "^1.11.10",
    "dompurify": "^3.3.3",
    "echarts": "^5.4.3",
    "element-plus": "^2.4.4",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
